# Choose one provider: anthropic | openai
LLM_PROVIDER=anthropic

# Put the key for the provider you chose. NEVER commit the real .env file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# LLM_MODEL=claude-haiku-5-5        # for openai e.g. gpt-4o-mini
# LLM_TIMEOUT_SECONDS=20
# MAX_HISTORY_TURNS=6
